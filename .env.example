# The backend loads the repository-root .env automatically at startup.
# Values already set in the process environment take precedence.
APP_ENV=development
DEMO_AUTH_ENABLED=false
AUTH_MODE=oidc
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
AUDIT_LOG_PATH=data/runtime/audit.jsonl
SECURITY_ALERTS_PATH=data/runtime/security_alerts.json
SECURITY_DENIAL_THRESHOLD=5
SECURITY_DENIAL_WINDOW_SECONDS=300
SECURITY_DENIAL_ALERT_COOLDOWN_SECONDS=600
THREAT_INGESTION_BLOCK_SEVERITY=high
JIRA_ACTIONS_PATH=data/runtime/jira_actions.json
JIRA_CREATED_ISSUES_PATH=data/runtime/jira_created_issues.json
KNOWLEDGE_STORE_PATH=data/runtime/knowledge.json
USER_STORE_PATH=data/runtime/users.json
RAG_BACKEND=qdrant
RAG_EMBEDDING_PROVIDER=ollama
RAG_GENERATION_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_CHAT_MODEL=llama3.2:3b
GROQ_API_KEY=
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
MISTRAL_API_KEY=
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_CHAT_MODEL=mistral-small-latest
# Hosted Groq/Mistral require AI_DATA_CLASS=synthetic and synthetic-only inputs.
# Groq supports chat here; Ollama or Mistral provides embeddings.
AI_DATA_CLASS=
QDRANT_LOCAL_PATH=data/runtime/qdrant
QDRANT_COLLECTION=knowledgeops
QDRANT_MIN_SCORE=0.5
MODERATION_MAX_INPUT_CHARS=2000
MODERATION_MIN_ANSWER_SUPPORT=0.35

# Real local Keycloak OIDC mode (demo auth is disabled when AUTH_MODE=oidc).
# Do not commit credentials or use real data in the local prototype.
OIDC_ISSUER_URL=http://localhost:8080/realms/knowledgeops
OIDC_AUDIENCE=knowledgeops-api
OIDC_GROUPS_CLAIM=groups
OIDC_GROUP_CAPABILITIES={"/knowledge/employee":["chat:ask","knowledge:read:general"],"/knowledge/hr":["chat:ask","knowledge:read:general","knowledge:read:hr"],"/knowledge/recruiter":["chat:ask","knowledge:read:general","recruitment:read"],"/knowledge/it-support":["chat:ask","knowledge:read:general","knowledge:read:it","jira:read","jira:propose"],"/knowledge/manager":["chat:ask","knowledge:read:general","knowledge:manage","jira:read","jira:approve"],"/knowledge/security":["chat:ask","threat_scans:scan","security_alerts:read","security_alerts:manage"],"/knowledge/administrator":["system:admin","audit:read","knowledge:manage","security_alerts:read","security_alerts:manage"]}

# Jira Cloud credentials are used by the backend only. Keep the API token secret.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# n8n security-alert webhook is optional. Use HTTPS except for local development.
# The webhook receives alert metadata and rule identifiers, never source content.
N8N_ALERT_WEBHOOK_URL=
N8N_ALERT_WEBHOOK_TOKEN=
N8N_JIRA_WEBHOOK_URL=
N8N_JIRA_WEBHOOK_TOKEN=

# Reserved placeholders: these integrations are not connected.
OPENAI_API_KEY=
